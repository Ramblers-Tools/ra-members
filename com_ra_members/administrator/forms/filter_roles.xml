<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" description="COM_RA_MEMBERS_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_RA_MEMBERS_FILTER_STATE"
               description="COM_RA_MEMBERS_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        

    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_RA_MEMBERS_LIST_FULL_ORDERING"
               description="COM_RA_MEMBERS_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.id ASC">COM_RA_MEMBERS_ID_ASC</option>
            <option value="a.id DESC">COM_RA_MEMBERS_ID_DESC</option>
            <option value="a.preferred_name ASC">COM_RA_MEMBERS_PREFERRED_NAME_ASC</option>
            <option value="a.preferred_name DESC">COM_RA_MEMBERS_PREFERRED_NAME_DESC</option>
            <option value="a.role ASC">COM_RA_MEMBERS_ROLE_ASC</option>
            <option value="a.role DESC">COM_RA_MEMBERS_ROLE_DESC</option>
            <option value="a.membershipNumber ASC">COM_RA_MEMBERS_MEMBERSHIP_NUMBER_ASC</option>
            <option value="a.membershipNumber DESC">COM_RA_MEMBERS_MEMBERSHIP_NUMBER_DESC</option>
            <option value="p.home_group ASC">COM_RA_MEMBERS_HOME_GROUP_ASC</option>
            <option value="p.home_group DESC">COM_RA_MEMBERS_HOME_GROUP_DESC</option>

        </field>

       <field name="limit"
               type="limitbox"
               label="COM_RA_MEMBERS_LIST_LIMIT"
               description="COM_RA_MEMBERS_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>