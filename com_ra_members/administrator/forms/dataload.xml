<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset>
            <field
                name="csv_file"
                type="file"
                label="File upload"
                description="Name of the data file on your computer"
                size="40"
                class="inputbox"
                default=""
                required="true"
                accept=".csv,text/csv,text/plain"
            />
            <field
                name="feed_mode"
                type="hidden"
                filter="cmd"
            />
            <field
                name="validation_type"
                type="radio"
                label="Validation/Process"
                description="Type of data to load"
                class="inputbox"
                size="1"
                required="true"
                default="2"
                >
                <option value="1">Check format of first four records</option>
                <option value="2">Process the complete file</option>
            </field>
</fieldset>
</form>
